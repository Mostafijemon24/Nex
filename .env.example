# Copy this file to .env and run ./scripts/prepare-env.sh to fill the empty secrets.
# Do not commit .env. The values below are development defaults only.

APP_ENV=development
SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

DATABASE_URL=postgresql+psycopg://docs:docs@localhost:5432/docs
REDIS_URL=redis://localhost:6379/0

STORAGE_DIR=./storage
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_LOCAL_TARGETS=false
# Set true in Docker images that cannot use Chromium's setuid sandbox.
CHROMIUM_NO_SANDBOX=true

MAX_UPLOAD_BYTES=52428800
MAX_ARCHIVE_FILES=5000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=200000000
LOG_LEVEL=INFO

API_PUBLIC_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://api:8000

POSTGRES_USER=docs
POSTGRES_PASSWORD=docs
POSTGRES_DB=docs
APP_DOMAIN=localhost

# Live OpenRouter verification (staging host only; never commit real values).
# Prefer the in-app encrypted provider credential UI. These are for scripts/live-openrouter-check.sh.
# OPENROUTER_API_KEY=
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/auto
